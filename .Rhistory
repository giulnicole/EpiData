# --- Introduciamo ~5% di valori mancanti casuali ---
introduce_missing <- function(df, prop = 0.05) {
n <- length(df)
na_indices <- sample(seq_len(n), size = round(n * prop))
df[na_indices] <- NA
return(df)
}
methylated <- introduce_missing(methylated, 0.05)
unmethylated <- introduce_missing(unmethylated, 0.05)
coverage <- introduce_missing(coverage, 0.05)
# Lista dei 3 data frame
bs_list <- list(
Coverage_matrix = coverage_df,
Met_matrix = methylated_df,
Unmet_matrix = unmethylated_df
)
# Controllo struttura
str(bs_list)
clean.coverage <- cleanCovMat(input.obj = bs_list, max_na_cpg = 0.5, max_na_ind = 0.2,  cpg_removal_threshold = 10)
clean.out<- cleanOutliers2(filtered.obj=clean.coverage, outlier_threshold=0, remove_outliers = T)
mat.values <- methValues2(clean.coverage)
stat.result <- statsCpG_parallel(mat.values)
View(mat.values)
