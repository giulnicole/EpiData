if (all(is.na(rowv))) {
block[r, ] <- colMeans(block, na.rm = TRUE)
} else {
nas <- is.na(rowv)
if (any(nas)) block[r, nas] <- mean(rowv, na.rm = TRUE)
}
}
}
m_imp[idx, ] <- block
}
rownames(m_imp) <- positions$CpG
SummarizedExperiment::assays(bs, withDimnames = FALSE)$M_values_imputed <- m_imp
return(bs)
}
