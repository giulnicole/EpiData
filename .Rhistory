data_with_na <- m
n <- nrow(m)
X <- m
# Convert the object to a matrix (if needed)
is_matrix <- is.matrix(X)
if (!is_matrix) {
X <- as.matrix(X)
}
throw<- which(is.na(rowMeans(X, na.rm = T)))
throw <- as.matrix(throw)
if(dim(throw)[1]==0) {
X2 <- X
} else {
