#' bs_imputed <- imputeBS(bs, method = 2)
#'
#' # Using mean imputation
#' bs_imputed <- imputeBS(bs, method = 1)
#'
#' # Using knnBSImpute
#' bs_imputed <- imputeBS(bs, method = 3)
#'
#' # Extract from specific experiment
#' bs_imputed <- imputeBS(bs, method = 2, experiment = "subset1")
imputeBS <- function(bs, method = 2, dist_threshold = 1000, experiment = NULL) {
# Validate method
if (!method %in% c(1, 2, 3)) {
stop("method must be 1 (mean), 2 (KNN via BSImpute), or 3 (knnBSImpute)")
}
# Extract M-values from specified experiment or default
if (!is.null(experiment)) {
# Check if experiment exists
if (!experiment %in% names(SummarizedExperiment::assays(bs))) {
stop(paste0("Experiment '", experiment, "' not found in BSseq object. ",
"Available assays: ",
paste(names(SummarizedExperiment::assays(bs)), collapse = ", ")))
}
# Extract M-values from specified experiment
m_values <- SummarizedExperiment::assay(bs, experiment)
# Create a temporary BSseq object with these M-values
bs_temp <- bs
SummarizedExperiment::assays(bs_temp, withDimnames = FALSE)$M <- m_values
} else {
# Use the original BSseq object as is
bs_temp <- bs
}
# Apply imputation based on method
if (method == 1) {
# Method 1: Mean imputation via BSImpute
bs_imputed <- BSImpute(
bs = bs_temp,
dist_threshold = dist_threshold,
impute_method = "mean"
)
} else if (method == 2) {
# Method 2: KNN imputation via BSImpute
bs_imputed <- BSImpute(
bs = bs_temp,
dist_threshold = dist_threshold,
impute_method = "knn"
)
} else if (method == 3) {
# Method 3: KNN imputation via knnBSImpute
bs_imputed <- knnBSImpute(
bs = bs_temp,
dist_threshold = dist_threshold
)
}
# Return the imputed BSseq object
return(bs_imputed)
}
#' @param experiment Experiment/assay to use for evaluation. Default NULL.
#'
#' @return List containing evaluation results for each method.
#'
#' @export
#'
#' @examples
#' # Compare all three methods
#' results <- compareImputeMethods(bs, methods = c(1, 2, 3), prop = 0.2)
#' print(results$comparison)
compareImputeMethods <- function(bs, methods = c(1, 2, 3),
prop = 0.2, mech = "MCAR",
dist_threshold = 1000,
experiment = NULL) {
# Extract original complete M-values
if (!is.null(experiment)) {
m_original <- SummarizedExperiment::assay(bs, experiment)
} else {
bs_mat <- extractMethData(bs)
m_original <- as.matrix(bs_mat[["m"]])
}
# Inject missing values
m_incomplete <- injectNA(
data = m_original,
prop = prop,
mech = mech
)
# Create BSseq object with incomplete data
bs_incomplete <- bs
if (!is.null(experiment)) {
SummarizedExperiment::assays(bs_incomplete, withDimnames = FALSE)[[experiment]] <- m_incomplete
} else {
SummarizedExperiment::assays(bs_incomplete, withDimnames = FALSE)$M <- m_incomplete
}
# Initialize results storage
method_names <- c("Mean (BSImpute)", "KNN (BSImpute)", "KNN (knnBSImpute)")
results_list <- list()
comparison_df <- data.frame(
Method = character(),
RMSE = numeric(),
MAE = numeric(),
stringsAsFactors = FALSE
)
# Evaluate each method
for (method in methods) {
cat("Evaluating method", method, ":", method_names[method], "\n")
# Apply imputation
bs_imputed <- imputeBS(
bs = bs_incomplete,
method = method,
dist_threshold = dist_threshold,
experiment = experiment
)
# Extract imputed M-values
m_imputed <- SummarizedExperiment::assay(bs_imputed, "M_values_imputed")
# Evaluate
eval_results <- evaluateImputation(
original = m_original,
imputed = m_imputed
)
# Store results
results_list[[method_names[method]]] <- eval_results
# Add to comparison
comparison_df <- rbind(comparison_df, data.frame(
Method = method_names[method],
RMSE = eval_results$overall$RMSE,
MAE = eval_results$overall$MAE,
stringsAsFactors = FALSE
))
}
# Find best method
best_rmse <- comparison_df$Method[which.min(comparison_df$RMSE)]
best_mae <- comparison_df$Method[which.min(comparison_df$MAE)]
cat("\n")
cat("=" %R% 70, "\n")
cat("COMPARISON SUMMARY\n")
cat("=" %R% 70, "\n")
print(comparison_df)
cat("\nBest method by RMSE:", best_rmse, "\n")
cat("Best method by MAE:", best_mae, "\n")
# Return all results
return(list(
comparison = comparison_df,
detailed_results = results_list,
best_rmse = best_rmse,
best_mae = best_mae
))
}
