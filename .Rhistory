# Combine all imputed data frames into one
combine_imputed <- function(chr_list) {
imputed_list <- lapply(chr_list, `[[`, "imputed")  # extract all $imputed
do.call(rbind, imputed_list)                       # row-bind all together
}
# Example use:
combined_imputed_df <- combine_imputed(myList)
# Combine all imputed data frames into one
combine_imputed <- function(chr_list) {
imputed_list <- lapply(chr_list, `[[`, "imputed")  # extract all $imputed
do.call(rbind, imputed_list)                       # row-bind all together
}
# Example use:
combined_imputed_df <- combine_imputed(imputed)
